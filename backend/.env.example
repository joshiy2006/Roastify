# Frontend origin allowed to call this API (comma-separated for multiple)
FRONTEND_ORIGIN=http://localhost:5173

# Spotify OAuth app (https://developer.spotify.com/dashboard) — used in a later batch
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/auth/spotify/callback

# Steam Web API key (https://steamcommunity.com/dev/apikey) — used in a later batch
STEAM_API_KEY=

# Groq API key (https://console.groq.com/keys) — used in a later batch
GROQ_API_KEY=
