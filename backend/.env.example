# Frontend origin allowed to call this API (comma-separated for multiple).
# Use 127.0.0.1, not localhost — browsers treat them as different sites, so a
# mismatch here makes the OAuth session cookie silently not get sent back.
# Open the frontend at http://127.0.0.1:5173 in your browser to match.
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Spotify OAuth app (https://developer.spotify.com/dashboard)
# Register SPOTIFY_REDIRECT_URI exactly (including scheme/port) in the app's dashboard.
# IMPORTANT: Spotify requires the IP literal 127.0.0.1, not "localhost", for
# loopback redirect URIs (enforced for all apps since November 2025) — using
# "localhost" here will make Spotify reject the login. The frontend's
# VITE_API_BASE_URL (frontend/.env) must use the same host as this URI,
# since that's where the OAuth session cookies get set.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# Set to true in production once the API is served over https
COOKIE_SECURE=false

# Steam Web API key (https://steamcommunity.com/dev/apikey) — used in a later batch
STEAM_API_KEY=

# Groq API key (https://console.groq.com/keys) — used in a later batch
GROQ_API_KEY=
